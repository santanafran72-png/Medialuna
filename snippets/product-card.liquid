<a class="product-card" href="{{ product.url }}"><div class="product-image">{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 800 | image_tag: loading:'lazy' }}{% else %}<div class="placeholder">🇨🇱</div>{% endif %}{% unless product.available %}<span class="soldout">Agotado</span>{% endunless %}</div><div class="product-meta"><h3>{{ product.title }}</h3><span>{{ product.price | money }}</span></div></a>